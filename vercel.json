{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": { "maxDuration": 30 },
    "api/conversations.ts": { "maxDuration": 10 },
    "api/conversations/[id].ts": { "maxDuration": 10 },
    "api/conversations/[id]/messages.ts": { "maxDuration": 10 },
    "api/memories.ts": { "maxDuration": 10 },
    "api/memories/[id].ts": { "maxDuration": 10 },
    "api/prompt-cache.ts": { "maxDuration": 10 },
    "api/subscription/status.ts": { "maxDuration": 10 },
    "api/subscription/config.ts": { "maxDuration": 10 },
    "api/subscription/webhook.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
